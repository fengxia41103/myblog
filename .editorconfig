root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,css,scss,html,json,yml,yaml}]
indent_size = 2

[*.md]
# Markdown: keep trailing whitespace (hard line breaks) and don't reflow.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.py]
indent_size = 4
max_line_length = 100
